<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dewwit_widget_background_light"
    android:padding="12dp">

    <ListView
        android:id="@+id/widget_task_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="4dp"
        android:paddingBottom="64dp" />

    <TextView
        android:id="@+id/widget_empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/widget_empty"
        android:textColor="@color/dewwit_widget_light_on_surface_variant"
        android:textSize="14sp" />

    <ImageButton
        android:id="@+id/widget_open_app"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="end|bottom"
        android:background="@drawable/dewwit_widget_action_background_light"
        android:contentDescription="@string/widget_open_app"
        android:padding="10dp"
        android:src="@drawable/dewwit_widget_open_app"
        android:tint="@color/dewwit_widget_light_on_primary_container" />

</FrameLayout>
